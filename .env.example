# Copy to .env for local development. On Vercel, set the same names under
# Settings -> Environment Variables (Production and Preview). See README.md.

# Supabase (browser + build time)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase (server)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

PUBLIC_SITE_URL=https://www.volumcalc.com

# Paddle (live only)
PADDLE_LIVE_API_KEY=
PADDLE_CLIENT_TOKEN=live_xxx
PADDLE_WEBHOOK_SECRET=

# E-mail: use Resend (recommended) OR Migadu SMTP
RESEND_API_KEY=
RESEND_FROM=post@volumcalc.com
MIGADU_SMTP_HOST=smtp.migadu.com
MIGADU_SMTP_PORT=465
MIGADU_SMTP_USER=
MIGADU_SMTP_PASSWORD=

# Contact form recipient (defaults to kjmersland@gmail.com)
CONTACT_RECIPIENT_EMAIL=kjmersland@gmail.com

# Only for drizzle-kit
DATABASE_URL=

# Provided by the Vercel Supabase integration (accepted as aliases)
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_ANON_KEY, POSTGRES_URL_NON_POOLING
